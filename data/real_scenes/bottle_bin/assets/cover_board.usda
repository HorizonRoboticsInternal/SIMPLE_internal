#usda 1.0
(
    defaultPrim = "cover_board"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "cover_board"
{
    def Xform "Meshes" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "visual"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            point3f[] points = [(-0.009000, -1.035000, -0.100000), (-0.009000, -1.035000, 0.100000), (-0.009000, 1.035000, -0.100000), (-0.009000, 1.035000, 0.100000), (0.009000, -1.035000, -0.100000), (0.009000, -1.035000, 0.100000), (0.009000, 1.035000, -0.100000), (0.009000, 1.035000, 0.100000)]
            color3f[] primvars:displayColor = [(0.88, 0.86, 0.8)]
            uniform token subdivisionScheme = "none"
        }
        def Mesh "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            point3f[] points = [(-0.009000, -1.035000, -0.100000), (-0.009000, -1.035000, 0.100000), (-0.009000, 1.035000, -0.100000), (-0.009000, 1.035000, 0.100000), (0.009000, -1.035000, -0.100000), (0.009000, -1.035000, 0.100000), (0.009000, 1.035000, -0.100000), (0.009000, 1.035000, 0.100000)]
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
        }
    }
    def Scope "Looks"
    {
    }
}
