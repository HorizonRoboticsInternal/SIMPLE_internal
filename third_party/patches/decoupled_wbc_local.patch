diff --git a/control/utils/state_shelf.py b/control/utils/state_shelf.py
new file mode 100644
index 0000000..1148b04
--- /dev/null
+++ b/control/utils/state_shelf.py
@@ -0,0 +1,51 @@
+"""Bounded, arrival-stamped shelf for the state/action messages the data exporter consumes (ROS-free).
+
+The old shelf kept ONE message and was consumed once per camera frame. Whenever the subscriber's
+spin thread was late for a camera period, the row had "no new state/action" and repeated the previous
+one (the duplicate-row defect, up to 20 % of an episode on 2026-09-17). This shelf keeps the last
+`maxlen` messages with their arrival times, so late/bursty delivery is never lost, reports whether a
+message is new, and lets the exporter wait a few ms for a fresher one before writing a row.
+"""
+import threading
+import time
+from collections import deque
+from typing import Any, Optional, Tuple
+
+
+class StateShelf:
+    def __init__(self, maxlen: int = 50, clock=time.monotonic):
+        self._buf = deque(maxlen=maxlen)
+        self._lock = threading.Lock()
+        self._clock = clock
+        self.seq = 0                 # messages received so far
+        self.last_used_seq = 0       # seq of the message last handed out by take_newest
+
+    def push(self, raw: Any) -> None:
+        with self._lock:
+            self.seq += 1
+            self._buf.append((self._clock(), self.seq, raw))
+
+    def newest(self) -> Optional[Tuple[float, int, Any]]:
+        with self._lock:
+            return self._buf[-1] if self._buf else None
+
+    def take_newest(self) -> Tuple[Optional[Any], bool, float]:
+        """-> (raw, is_new, arrival_time). is_new: not handed out before (a row built from it is not a duplicate)."""
+        with self._lock:
+            if not self._buf:
+                return None, False, float("nan")
+            t, seq, raw = self._buf[-1]
+            is_new = seq > self.last_used_seq
+            self.last_used_seq = seq
+            return raw, is_new, t
+
+    def wait_for_newer(self, timeout: float, poll: float = 0.001, sleep=time.sleep) -> bool:
+        """Block up to `timeout` s until a message newer than the last handed-out one arrives."""
+        deadline = self._clock() + timeout
+        while True:
+            n = self.newest()
+            if n is not None and n[1] > self.last_used_seq:
+                return True
+            if self._clock() >= deadline:
+                return False
+            sleep(poll)
