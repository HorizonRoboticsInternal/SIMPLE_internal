+            out = self._home_to + (ik_q - self._home_to) * w
+            if t >= 1.0:
+                self._state = "tracking"
+
+        action["target_upper_body_pose"] = out
+        self._last_published = np.array(out, dtype=float).copy()
+        self.retargeting_ik._most_recent_q[self._upper_idx()] = self._last_published
