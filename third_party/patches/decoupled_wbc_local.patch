+        if self._state == "free":
+            # Just activated: glide to the parked pose instead of the stock snap.
+            self._begin_homing(self._last_published if self._last_published is not None else ik_q, self._current_height(action))
+
+        out = ik_q
+        if self._state == "tracking":
+            if pressed_c or pressed_x:
+                print(f"[teleop] episode {'saved' if pressed_c else 'discarded'} -> returning to parked pose")
+                # Start the ramp from what the robot was last COMMANDED, not from this tick's
+                # fresh IK output: if the operator's hands move at the press instant the IK
