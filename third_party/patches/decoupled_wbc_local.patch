@@ -0,0 +1,24 @@
+"""Navigation command as written into the recording (ROS-free; importable by tests)."""
+try:
+    from decoupled_wbc.control.main.constants import DEFAULT_NAV_CMD
+except Exception:  # pragma: no cover - constants module unavailable in a minimal env
+    DEFAULT_NAV_CMD = [0.0, 0.0, 0.0, 0.0]
+
+
+def recorded_navigate_cmd(last_teleop_cmd, wbc_action):
+    """[vx, vy, turn flag, target_yaw] for the data exporter.
+
+    vx, vy and the turn flag are what the operator commanded. target_yaw is `target_yaw_rel`
+    from the lower-body policy: the dial RELATIVE to the heading at the A press, so it is
+    exactly 0 at episode start and does not depend on where the robot faces in the room
+    (Psi convention). The fallback to the synced absolute dial exists only for policies that
+    do not report `target_yaw_rel`; G1DecoupledWholeBodyPolicy must forward it (regression
+    test: tests/test_target_yaw_relative.py)."""
+    nav = list(last_teleop_cmd.get("navigate_cmd", DEFAULT_NAV_CMD))
+    if isinstance(wbc_action, dict) and "target_yaw_rel" in wbc_action and len(nav) >= 4:
+        nav[3] = float(wbc_action["target_yaw_rel"])
+        return nav
+    synced = wbc_action.get("navigate_cmd") if isinstance(wbc_action, dict) else None
+    if synced is not None and len(synced) >= 4 and len(nav) >= 4:
+        nav[3] = float(synced[3])
+    return nav
