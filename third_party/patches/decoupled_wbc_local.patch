+    "left_elbow_joint": 0.064, "left_wrist_roll_joint": 0.026, "left_wrist_pitch_joint": 0.024, "left_wrist_yaw_joint": 0.018,
+    "right_shoulder_pitch_joint": 0.055, "right_shoulder_roll_joint": 0.019, "right_shoulder_yaw_joint": 0.017,
+    "right_elbow_joint": 0.051, "right_wrist_roll_joint": 0.024, "right_wrist_pitch_joint": 0.020, "right_wrist_yaw_joint": 0.020,
