+        q_up = self._home_to if getattr(self, "_home_to", None) is not None else None
+        cache = getattr(self, "_parked_ee_cache", None)
+        if cache is not None and (q_up is None or np.array_equal(cache[0], q_up)):
+            return cache[1]
+        q = np.array(pp.robot.default_body_pose, dtype=float).copy()
+        if q_up is not None:
+            q[self._upper_idx()] = q_up
+        pp.robot.cache_forward_kinematics(q, auto_clip=False)
+        ee = {n: pp.robot.frame_placement(n).np.copy() for n in pp.ee_name_list}
+        pp.robot.reset_forward_kinematics()
