+def min_jerk_ramp(q_from: np.ndarray, q_to: np.ndarray, elapsed: float, duration: float) -> np.ndarray:
+    """Point on a minimum-jerk trajectory from q_from to q_to at time `elapsed`.
+
+    s(t) = 10t^3 - 15t^4 + 6t^5 has zero velocity and acceleration at both ends, so the
+    arms neither jerk off the operator's last pose nor slam into the home pose.
+    """
+    if duration <= 0:
+        return q_to.copy()
+    t = min(max(elapsed / duration, 0.0), 1.0)
+    s = 10 * t**3 - 15 * t**4 + 6 * t**5
+    return q_from + (q_to - q_from) * s
+
+
+def clip_step(q_prev: np.ndarray, q_des: np.ndarray, max_speed: float, dt: float) -> np.ndarray:
+    """Move from q_prev toward q_des, but never faster than max_speed (rad/s) on any joint."""
+    if max_speed <= 0 or dt <= 0:
+        return q_des.copy()
+    lim = max_speed * dt
+    return q_prev + np.clip(q_des - q_prev, -lim, lim)
+
