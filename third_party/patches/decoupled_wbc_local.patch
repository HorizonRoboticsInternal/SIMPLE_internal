+def _listeners_on(port: int) -> int:
+    """Number of TCP listeners on `port` (ss sees the host's sockets under --network=host)."""
+    try:
+        out = subprocess.run(["ss", "-Htln", f"sport = :{port}"], capture_output=True, text=True, timeout=2).stdout
+        return sum(1 for line in out.splitlines() if line.strip())
+    except Exception:
+        return 1 if _port_open("127.0.0.1", port) else 0
+
+
+def _port_open(host: str, port: int) -> bool:
+    import socket
+    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(0.2)
+    try:
+        return s.connect_ex((host, port)) == 0
+    finally:
+        s.close()
+
+
+def integrate_yaw_dial(prev: float, vyaw: float, dt: float) -> float:
+    """Integrate the yaw stick into the target-yaw dial WITHOUT wrapping.
+
+    The dial is an unbounded, continuous angle. It used to be wrapped to [-pi, pi]; whenever the
+    accumulated dial crossed +-pi the value jumped by 2pi, and downstream that jump was linearly
+    interpolated / rate-limited into a ~1 s sweep through every heading, which the yaw controller
+    followed (robot wobbles) and the recorder wrote (real_recordings 2026-09-17 ep 4/5/9/12).
+    The consumer (G1GearWbcPolicy) wraps the yaw ERROR, so an unbounded dial is exactly right."""
+    return float(prev) + float(vyaw) * float(dt)
+
