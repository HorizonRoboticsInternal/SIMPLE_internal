new file mode 100644
index 0000000..dd4b94c
--- /dev/null
+++ b/control/envs/g1/utils/gravity_ff.py
@@ -0,0 +1,21 @@
+"""Feed-forward gravity torque for the real G1 (ROS/SDK-free, unit-testable).
+
+The teleop stack used to send tau = 0 to every motor (pure PD), so the arms sag under gravity
+(elbow ~+0.09 rad, wrist ~+0.05 rad at rest). With `enable_gravity_compensation` the env adds the
+generalized gravity torque g(q) of the selected joint groups (default: arms) as the motor
+feed-forward, computed at the COMMANDED target pose, the same thing the Psi-0 deploy client does
+when ARM_GRAVITY_COMP=on. Torques are clipped per joint for safety.
+"""
+from typing import List, Optional, Sequence
+
+import numpy as np
+
+
+def gravity_feedforward_actuated(robot_model, q_joint_order: np.ndarray, joint_groups: Optional[Sequence[str]] = ("arms",),
+                                 max_torque: float = 10.0) -> np.ndarray:
+    """Return the body-actuator-order (29,) feed-forward torque for `joint_groups` at pose q (joint order, num_dofs)."""
+    groups: List[str] = list(joint_groups) if joint_groups else ["arms"]
+    tau_joint = robot_model.compute_gravity_compensation_torques(np.asarray(q_joint_order, dtype=float), joint_groups=groups)
+    tau_act = np.asarray(robot_model.get_body_actuated_joints(tau_joint), dtype=float)
+    lim = abs(float(max_torque))
+    return np.clip(np.nan_to_num(tau_act), -lim, lim)
