new file mode 100644
index 0000000..c28022a
--- /dev/null
+++ b/control/sensor/realsense.py
@@ -0,0 +1,134 @@
+"""RealSense camera sensor for the composed camera server.
+
+composed_camera.py lazily imports ``RealSenseSensor`` from this module, but the
+file was never included in the SONIC fork (upstream GR00T-WholeBodyControl lacks
+it as well), so ``--ego-view-camera realsense`` crashed with ModuleNotFoundError.
+
+Minimal implementation matching the OAKSensor contract used by
+ComposedCameraSensor's camera threads:
+
+    read() -> {"timestamps": {mount_position: unix_seconds},
+               "images":     {mount_position: HxWx3 RGB uint8}}   (or None)
+    observation_space() -> gym.spaces.Dict
+    close()
+
+Frame size defaults to 640x360 to match RS_VIEW_CAMERA_HEIGHT/WIDTH in
+data/constants.py (the shape the data exporter declares); that is a native
+D4xx color mode. Falls back to 640x480 + resize if the mode is unavailable.
+"""
+import time
+from typing import Any, Dict, Optional
+
+import gymnasium as gym
+import numpy as np
+
+from decoupled_wbc.control.base.sensor import Sensor
+
+try:
+    import pyrealsense2 as rs
+except ImportError as exc:  # pragma: no cover
+    raise ImportError(
+        "pyrealsense2 is required for RealSenseSensor (pip install pyrealsense2)"
+    ) from exc
+
+
+class RealSenseSensor(Sensor):
+    WIDTH = 640
+    HEIGHT = 360
+    FPS = 30
+    FALLBACK_WIDTH = 640
+    FALLBACK_HEIGHT = 480
+
+    def __init__(self, mount_position: str = "ego_view", device_id: Optional[str] = None):
+        self.mount_position = mount_position
+        self._resize = None  # (w, h) to resize to when using the fallback mode
+        self._started = False
+
+        self.pipeline = rs.pipeline()
+        config = rs.config()
+        if device_id:
+            config.enable_device(device_id)
+
+        try:
+            config.enable_stream(
+                rs.stream.color, self.WIDTH, self.HEIGHT, rs.format.rgb8, self.FPS
+            )
+            self.profile = self.pipeline.start(config)
+        except RuntimeError:
+            # 640x360 not offered by this device/firmware: use a common mode and resize
+            config = rs.config()
+            if device_id:
+                config.enable_device(device_id)
+            config.enable_stream(
+                rs.stream.color,
+                self.FALLBACK_WIDTH,
+                self.FALLBACK_HEIGHT,
+                rs.format.rgb8,
+                self.FPS,
+            )
+            self.profile = self.pipeline.start(config)
+            self._resize = (self.WIDTH, self.HEIGHT)
+
+        self._started = True
+        dev = self.profile.get_device()
+        name = dev.get_info(rs.camera_info.name)
+        serial = dev.get_info(rs.camera_info.serial_number)
+        mode = f"{self.FALLBACK_WIDTH}x{self.FALLBACK_HEIGHT}->" if self._resize else ""
+        print(
+            f"[RealSense] {name} (S/N {serial}) streaming "
+            f"{mode}{self.WIDTH}x{self.HEIGHT}@{self.FPS} for '{mount_position}'"
+        )
+
+    def read(self) -> Optional[Dict[str, Any]]:
+        try:
+            frames = self.pipeline.wait_for_frames(timeout_ms=1000)
+        except RuntimeError as e:
+            print(f"[ERROR] RealSense read failed for {self.mount_position}: {e}")
+            return None
+
+        color = frames.get_color_frame()
+        if not color:
+            return None
+
+        image = np.asanyarray(color.get_data())  # already RGB (rs.format.rgb8)
+        if self._resize is not None:
+            import cv2
+
+            image = cv2.resize(image, self._resize, interpolation=cv2.INTER_AREA)
+
+        # RealSense timestamps are milliseconds; in the global/system clock
+        # domain they are epoch-based. If this one clearly is not (hardware
+        # clock domain), fall back to wall time so the exporter's image/state
+        # delta check stays meaningful.
+        ts = color.get_timestamp() / 1000.0
+        now = time.time()
+        if abs(ts - now) > 60.0:
+            ts = now
+
+        return {
+            "timestamps": {self.mount_position: ts},
+            "images": {self.mount_position: image},
+        }
+
+    def observation_space(self) -> gym.Space:
+        return gym.spaces.Dict(
+            {
+                "color_image": gym.spaces.Box(
+                    low=0,
+                    high=255,
+                    shape=(self.HEIGHT, self.WIDTH, 3),
+                    dtype=np.uint8,
+                )
+            }
+        )
+
+    def close(self):
+        if self._started:
+            try:
+                self.pipeline.stop()
+            except RuntimeError:
+                pass
+            self._started = False
+
+    def __del__(self):
+        self.close()
